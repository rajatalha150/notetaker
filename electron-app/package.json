{
  "name": "notetaker-desktop",
  "version": "0.1.0",
  "main": "dist-electron/main.js",
  "description": "Privacy-first AI meeting recorder, transcriber, and summarizer. Record, transcribe, and summarize meetings entirely on-device.",
  "author": "Peak Services Inc. <support@peakservices-inc.com>",
  "license": "Proprietary",
  "homepage": "https://peakservices-inc.com",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:deb": "tsc && vite build && electron-builder --linux deb",
    "build:appimage": "tsc && vite build && electron-builder --linux AppImage",
    "build:linux": "tsc && vite build && electron-builder --linux deb AppImage",
    "preview": "vite preview"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "^1.92.0",
    "lucide-react": "^0.453.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.27",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.peakservices.notetaker",
    "productName": "Notetaker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "linux": {
      "target": ["deb", "AppImage"],
      "category": "Utility",
      "icon": "build/icons",
      "desktop": {
        "Name": "Notetaker",
        "Comment": "Privacy-first AI meeting recorder, transcriber, and summarizer",
        "Categories": "AudioVideo;Audio;Utility;",
        "Keywords": "meeting;record;transcribe;summarize;notes;ai;",
        "MimeType": "audio/webm;audio/ogg;",
        "StartupWMClass": "notetaker-desktop"
      },
      "synopsis": "AI-powered meeting assistant that runs entirely on your device",
      "description": "Notetaker is a privacy-first meeting assistant that silently records, transcribes, and summarizes video calls across native desktop applications. It uses on-device AI models (TinyLlama 1.1B, Whisper) so no data ever leaves your machine."
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "recommends": [
        "pulseaudio",
        "pipewire"
      ],
      "priority": "optional",
      "packageCategory": "sound",
      "afterInstall": "build/after-install.sh",
      "afterRemove": "build/after-remove.sh"
    },
    "win": {
      "target": ["portable", "nsis"]
    }
  }
}
